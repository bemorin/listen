// Small building blocks: glyphs, buttons, sliders. Geometry comes from the Windows app.

import { T, M, Tip } from "theme.slint";

// A stroked vector glyph. `bx/by/bw/bh` is the geometry's bounding box, fitted to the size.
export component Glyph inherits Path {
    in property <color> color: T.text;
    in property <length> thickness: 1.55px;
    in property <float> bx;
    in property <float> by;
    in property <float> bw: 20;
    in property <float> bh: 20;
    viewbox-x: self.bx;
    viewbox-y: self.by;
    viewbox-width: self.bw;
    viewbox-height: self.bh;
    stroke: self.color;
    stroke-width: self.thickness;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    animate stroke { duration: T.medium; easing: ease-out; }
}

// Shows the shared tooltip after a hover pause; hides it when the pointer leaves.
component TipSource {
    in property <string> tip;
    in property <bool> hovered;
    in property <bool> pressed;
    in property <length> anchor-x;
    in property <length> anchor-top;
    in property <length> anchor-bottom;
    property <int> id: 0;
    init => {
        self.id = Tip.next-owner;
        Tip.next-owner += 1;
    }
    changed hovered => {
        if (!self.hovered && Tip.owner == self.id) {
            Tip.shown = false;
        }
    }
    changed pressed => {
        if (self.pressed && Tip.owner == self.id) {
            Tip.shown = false;
        }
    }
    Timer {
        interval: Tip.shown ? 60ms : 600ms;
        running: root.hovered && !root.pressed && root.tip != "" && !(Tip.shown && Tip.owner == root.id);
        triggered => {
            Tip.text = root.tip;
            Tip.x = root.anchor-x;
            Tip.top = root.anchor-top;
            Tip.bottom = root.anchor-bottom;
            Tip.owner = root.id;
            Tip.shown = true;
        }
    }
}

export component IconButton inherits Rectangle {
    in property <length> size: 30px;
    in property <length> radius: 8px;
    in property <string> tip;
    in property <color> rest: transparent;
    in property <bool> enabled: true;
    callback clicked;
    out property <bool> hovered: ta.has-hover;
    out property <bool> down: ta.pressed;
    width: self.size;
    height: self.size;
    border-radius: self.radius;
    background: !root.enabled ? root.rest : ta.pressed ? T.pressed : ta.has-hover ? T.hover : root.rest;
    animate background { duration: T.quick; easing: ease-out; }

    @children

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            Tip.shown = false;
            root.clicked();
        }
    }

    TipSource {
        tip: root.tip;
        hovered: ta.has-hover;
        pressed: ta.pressed;
        anchor-x: root.absolute-position.x + root.width / 2;
        anchor-top: root.absolute-position.y;
        anchor-bottom: root.absolute-position.y + root.height;
    }
}

// Glyph button of the Windows app (topmost, mini, minimise, close, queue...).
export component GlyphButton inherits IconButton {
    in property <string> commands;
    in property <float> bx;
    in property <float> by;
    in property <float> bw: 20;
    in property <float> bh: 20;
    in property <length> glyph: 16px;
    in property <color> ink: T.text;
    in property <length> thickness: 1.55px;
    Glyph {
        width: root.glyph * root.bw / max(root.bw, root.bh);
        height: root.glyph * root.bh / max(root.bw, root.bh);
        commands: root.commands;
        bx: root.bx;
        by: root.by;
        bw: root.bw;
        bh: root.bh;
        color: root.ink;
        thickness: root.thickness;
        opacity: root.down ? 0.75 : 1;
        animate opacity { duration: T.quick; }
    }
}

// Filled skip glyph: a bar and a triangle on a 20x20 canvas.
export component SkipButton inherits IconButton {
    in property <bool> forward;
    in property <length> glyph: 18px;
    Path {
        width: root.glyph;
        height: root.glyph;
        viewbox-width: 20;
        viewbox-height: 20;
        fill: T.text;
        commands: root.forward
            ? "M5,4 L14.5,10 L5,16 Z M16.2,4.9 C16.2,4.4 16.6,4 17.1,4 C17.6,4 18,4.4 18,4.9 L18,15.1 C18,15.6 17.6,16 17.1,16 C16.6,16 16.2,15.6 16.2,15.1 Z"
            : "M15,4 L5.5,10 L15,16 Z M2,4.9 C2,4.4 2.4,4 2.9,4 C3.4,4 3.8,4.4 3.8,4.9 L3.8,15.1 C3.8,15.6 3.4,16 2.9,16 C2.4,16 2,15.6 2,15.1 Z";
        // A small nudge in the direction of travel on press.
        x: (parent.width - self.width) / 2 + (root.down ? (root.forward ? 1.5px : -1.5px) : 0);
        animate x { duration: T.quick; easing: M.settle; }
    }
}

// Play / pause, framed by the accent ring. The glyphs cross-fade with a slight scale.
export component PlayButton inherits IconButton {
    in property <bool> playing;
    in property <length> glyph: 19px;
    rest: T.elevated;
    border-width: 1px;
    border-color: T.accent;
    property <length> inner: root.down ? root.glyph * 0.88 : root.glyph;
    animate inner { duration: T.medium; easing: M.spring; }

    // Play
    Path {
        width: root.inner * (root.playing ? 0.6 : 1);
        height: self.width;
        x: (parent.width - self.width) / 2 + self.width * 0.06;
        viewbox-x: 4;
        viewbox-y: 2;
        viewbox-width: 12;
        viewbox-height: 16;
        fill: T.text;
        commands: "M5.2,2.6 C4.6,2.2 4,2.6 4,3.3 L4,16.7 C4,17.4 4.6,17.8 5.2,17.4 L15.3,10.7 C15.8,10.3 15.8,9.7 15.3,9.3 Z";
        opacity: root.playing ? 0 : 1;
        animate opacity, width { duration: T.medium; easing: M.spring; }
    }
    // Pause
    Rectangle {
        width: root.inner * (root.playing ? 1 : 0.6);
        height: self.width;
        opacity: root.playing ? 1 : 0;
        animate opacity, width { duration: T.medium; easing: M.spring; }
        Rectangle {
            x: parent.width * 0.5 - 1.5px - self.width;
            width: max(2.2px, parent.width * 0.17);
            height: parent.height * 0.72;
            border-radius: 1px;
            background: T.text;
        }
        Rectangle {
            x: parent.width * 0.5 + 1.5px;
            width: max(2.2px, parent.width * 0.17);
            height: parent.height * 0.72;
            border-radius: 1px;
            background: T.text;
        }
    }
}

// Repeat: an infinity sign; accent when on, a small "1" above it for repeat-one.
export component RepeatButton inherits IconButton {
    in property <int> mode;
    in property <bool> small;
    property <color> c: root.mode == 0 ? T.text : T.accent;
    Glyph {
        width: root.small ? 16px : 18px;
        height: root.small ? 9.5px : 10.5px;
        y: (parent.height - self.height) / 2 + (root.mode == 2 ? 2.5px : 0);
        animate y { duration: T.medium; easing: M.spring; }
        bx: 1.5;
        by: 4.7;
        bw: 15;
        bh: 6.6;
        thickness: 1.65px;
        color: root.c;
        commands: "M1.5,8 C1.5,4.6 5.0,3.9 8.8,8 C12.6,12.1 16.5,11.4 16.5,8 C16.5,4.6 13.0,3.9 9.2,8 C5.4,12.1 1.5,11.4 1.5,8";
    }
    Text {
        text: "1";
        color: T.accent;
        font-family: T.time-font;
        font-size: root.small ? 7px : 7.6px;
        font-weight: 700;
        y: root.mode == 2 ? parent.height / 2 - 11px : parent.height / 2 - 6px;
        opacity: root.mode == 2 ? 1 : 0;
        animate y, opacity { duration: T.medium; easing: M.spring; }
    }
}

export component DotsButton inherits IconButton {
    for i in 3: Rectangle {
        width: 2.4px;
        height: 2.4px;
        border-radius: 1.2px;
        background: T.text;
        y: parent.height / 2 - 1.2px + (i - 1) * 5.2px;
    }
}

// Pill text button of the queue header (Add, Remove, Clear).
export component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    height: 24px;
    width: label.preferred-width + 20px;
    border-radius: 8px;
    border-width: 1px;
    border-color: ta.has-hover && root.enabled ? T.strong-border : T.border;
    background: !root.enabled ? transparent : ta.pressed ? T.pressed : ta.has-hover ? T.hover : transparent;
    animate background, border-color { duration: T.quick; }
    label := Text {
        text: root.text;
        color: !root.enabled ? T.border.mix(T.muted, 0.4) : ta.has-hover ? T.secondary : T.muted;
        font-size: 10.5px;
        animate color { duration: T.quick; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Seek and volume slider: a thin track that thickens under the pointer, with a thumb.
export component Slider inherits Rectangle {
    // Value shown while not dragging.
    in property <float> value;
    in property <bool> show-thumb: true;
    in property <length> track: 3px;
    in property <bool> enabled: true;
    in property <bool> grow-on-hover: true;
    in property <bool> wheel: false;
    // Live value while dragging (also set on press).
    callback scrub(float);
    // Final value on release.
    callback commit(float);
    out property <bool> dragging: ta.pressed;
    out property <bool> hovered: ta.has-hover;
    out property <float> shown: ta.pressed ? root.drag-value : root.value;
    out property <float> hover-value: clamp((ta.mouse-x - root.inset) / max(1px, root.width - 2 * root.inset), 0, 1);
    out property <length> hover-x: root.inset + root.hover-value * (root.width - 2 * root.inset);
    property <float> drag-value;
    property <length> inset: root.show-thumb ? 7px : 0px;
    property <bool> hot: (ta.has-hover || ta.pressed) && root.enabled;
    property <length> h: root.hot && root.grow-on-hover ? root.track + 2px : root.track;
    animate h { duration: T.medium; easing: M.settle; }

    Rectangle {
        x: root.inset;
        width: root.width - 2 * root.inset;
        height: root.h;
        border-radius: self.height / 2;
        background: T.track;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.shown, 0, 1);
            height: parent.height;
            border-radius: parent.border-radius;
            background: T.accent;
        }
    }
    if root.show-thumb && root.enabled: Rectangle {
        property <length> r: root.hot ? 6px : 4px;
        animate r { duration: T.medium; easing: M.spring; }
        x: root.inset + (root.width - 2 * root.inset) * clamp(root.shown, 0, 1) - self.r;
        width: self.r * 2;
        height: self.r * 2;
        border-radius: self.r;
        background: T.thumb;
        drop-shadow-blur: root.hot ? 4px : 0px;
        drop-shadow-color: #0008;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down) {
                    root.drag-value = root.hover-value;
                    root.scrub(root.drag-value);
                } else if (e.kind == PointerEventKind.up) {
                    root.commit(root.drag-value);
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.drag-value = root.hover-value;
                root.scrub(root.drag-value);
            }
        }
        scroll-event(e) => {
            if (!root.wheel) { return reject; }
            root.commit(clamp(root.value + (e.delta-y > 0 ? 0.05 : -0.05), 0, 1));
            accept
        }
    }
}
