// Listen: the whole window. Every layout change is a function of the window height, so a
// resize drag or an animated window morph plays the same continuous transition: the artwork
// shrinks and fades, the centred title gives way to the title-bar title, then the mini player.

import { T, M, L, Tip } from "theme.slint";
import { Glyph, IconButton, GlyphButton, SkipButton, PlayButton, RepeatButton, DotsButton, PillButton, Slider, TipSource } from "controls.slint";

export { T, L }

export struct QueueItem {
    title: string,
    duration: string,
    ext: string,
}

// "03:24" from seconds.
global Fmt {
    public pure function two(n: int) -> string {
        return (n < 10 ? "0" : "") + n;
    }
    public pure function clock(seconds: float) -> string {
        if (seconds >= 3600) {
            return self.two(floor(seconds / 3600)) + ":" + self.two(mod(floor(seconds / 60), 60)) + ":" + self.two(mod(floor(seconds), 60));
        }
        return self.two(floor(seconds / 60)) + ":" + self.two(mod(floor(seconds), 60));
    }
}

// Plus badge + label, the "add audio" affordance of the empty states.
component AddHint inherits Rectangle {
    in property <string> text;
    in property <bool> interactive: true;
    in property <length> font: 12px;
    callback clicked;
    width: row.preferred-width + (root.interactive ? 26px : 0px);
    height: root.interactive ? 30px : 18px;
    border-radius: 10px;
    border-width: 1px;
    border-color: ta.has-hover && root.interactive ? T.hairline : transparent;
    background: ta.has-hover && root.interactive ? (ta.pressed ? T.glass-pressed : T.glass-hover) : transparent;
    animate background, border-color { duration: T.quick; }
    row := HorizontalLayout {
        alignment: center;
        spacing: 8px;
        if root.interactive: Rectangle {
            y: (parent.height - self.height) / 2;
            width: 19px;
            height: 19px;
            border-radius: 6px;
            background: ta.has-hover ? T.glass-hover : T.glass-raised;
            border-width: 1px;
            border-color: ta.has-hover ? T.hairline : T.hairline-soft;
            animate background, border-color { duration: T.quick; }
            Glyph {
                width: 9px;
                height: 9px;
                bx: 6;
                by: 6;
                bw: 8;
                bh: 8;
                thickness: 1.45px;
                color: ta.has-hover ? T.secondary : T.muted;
                commands: "M10,6 L10,14 M6,10 L14,10";
            }
        }
        Text {
            text: root.text;
            font-size: root.font;
            color: ta.has-hover && root.interactive ? #B8B8B8 : T.muted;
            vertical-alignment: center;
            overflow: elide;
            animate color { duration: T.quick; }
        }
    }
    ta := TouchArea {
        enabled: root.interactive;
        mouse-cursor: root.interactive ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Shown while audio files are dragged over the window.
component DropOverlay inherits Rectangle {
    in property <bool> active;
    in property <bool> compact;
    in property <string> title;
    in property <string> subtitle;
    background: T.drop-overlay;
    border-radius: root.compact ? 10px : 14px;
    border-width: 1px;
    border-color: T.drop-badge-border;
    opacity: root.active ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity { duration: T.medium; easing: ease-out; }
    VerticalLayout {
        alignment: center;
        spacing: root.compact ? 2px : 4px;
        if !root.compact: HorizontalLayout {
            alignment: center;
            Rectangle {
                width: root.active ? 38px : 30px;
                height: self.width;
                animate width { duration: T.slow; easing: M.spring; }
                border-radius: 12px;
                background: T.drop-badge;
                border-width: 1px;
                border-color: T.drop-badge-border;
                Glyph {
                    width: 16px;
                    height: 16px;
                    bx: 4;
                    by: 4;
                    bw: 12;
                    bh: 12;
                    thickness: 1.7px;
                    color: T.text;
                    commands: "M10,4 L10,16 M4,10 L16,10";
                }
            }
        }
        Rectangle { height: root.compact ? 0px : 6px; }
        Text {
            text: root.title;
            color: T.text;
            font-size: root.compact ? 13px : 14px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: root.subtitle;
            color: T.muted;
            font-size: 10.5px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

// Window-move surface: a press-and-drag hands the move to the OS once the pointer travels
// a few pixels, so clicks and double-clicks on it stay ordinary clicks.
component DragSurface inherits TouchArea {
    callback start-drag;
    property <length> px;
    property <length> py;
    property <bool> armed;
    pointer-event(e) => {
        if (e.button == PointerEventButton.left) {
            if (e.kind == PointerEventKind.down) {
                self.px = self.mouse-x;
                self.py = self.mouse-y;
                self.armed = true;
            } else if (e.kind == PointerEventKind.up) {
                self.armed = false;
            }
        }
    }
    moved => {
        if (self.armed && self.pressed && (abs(self.mouse-x - self.px) > 3px || abs(self.mouse-y - self.py) > 3px)) {
            self.armed = false;
            root.start-drag();
        }
    }
}

// Three bars beside the current queue item. While it plays they move continuously, each on
// its own slow wave; paused, they settle low.
component NowPlaying inherits Rectangle {
    in property <bool> playing;
    width: 11px;
    height: 10px;
    in property <float> wave;
    property <float> t: root.wave * 1000;
    for i in 3: Rectangle {
        property <float> phase: i * 2.1;
        property <float> speed: 0.0052 + i * 0.0011;
        property <float> level: root.playing
            ? 0.55 + 0.3 * sin((root.t * self.speed + self.phase) * 1rad) + 0.15 * sin((root.t * self.speed * 2.3 + self.phase * 1.7) * 1rad)
            : 0.3;
        x: i * 4px;
        width: 2.4px;
        border-radius: 1px;
        background: @linear-gradient(0deg, #8E8E93 0%, #FFFFFF 100%);
        height: root.height * clamp(self.level, 0.18, 1);
        y: root.height - self.height;
    }
}

component QueueRow inherits Rectangle {
    in property <QueueItem> item;
    in property <bool> current;
    in property <bool> selected;
    in property <bool> playing;
    in property <float> wave;
    in property <string> remove-tip;
    in property <bool> lifted;
    callback select;
    callback activate;
    callback remove;
    // Press and drag vertically to reorder; `dy` is the pointer's travel since the press.
    callback drag-move(length);
    callback drag-end();
    height: 32px;
    border-radius: 8px;
    background: root.lifted ? #2A2A2AF0 : root.selected ? T.glass-raised : ta.has-hover ? T.glass : transparent;
    border-width: root.lifted ? 1px : 0px;
    border-color: T.hairline;
    animate background { duration: T.quick; }
    drop-shadow-blur: root.lifted ? 12px : 0px;
    drop-shadow-offset-y: root.lifted ? 4px : 0px;
    drop-shadow-color: #00000080;

    ta := TouchArea {
        property <length> start;
        property <bool> dragging;
        pointer-event(e) => {
            if (e.button != PointerEventButton.left) { return; }
            if (e.kind == PointerEventKind.down) {
                self.start = root.absolute-position.y + self.mouse-y;
                self.dragging = false;
            } else if (e.kind == PointerEventKind.up && self.dragging) {
                self.dragging = false;
                root.drag-end();
            }
        }
        moved => {
            if (!self.pressed) { return; }
            // Pointer travel in window space, independent of the row moving under it.
            if (self.dragging || abs(root.absolute-position.y + self.mouse-y - self.start) > 4px) {
                self.dragging = true;
                root.drag-move(root.absolute-position.y + self.mouse-y - self.start);
            }
        }
        clicked => {
            if (!self.dragging) { root.select(); }
        }
        double-clicked => { root.activate(); }
    }
    if root.current: NowPlaying {
        x: 8px;
        playing: root.playing;
        wave: root.wave;
    }
    Text {
        x: 28px;
        width: ext.x - self.x - 8px;
        height: parent.height;
        vertical-alignment: center;
        overflow: elide;
        font-size: 11.5px;
        color: root.current ? T.text : T.secondary;
        font-weight: root.current ? 600 : 400;
        text: root.item.title;
    }
    ext := Text {
        x: parent.width - self.width - 10px;
        height: parent.height;
        vertical-alignment: center;
        font-size: 10px;
        color: T.muted;
        font-family: T.time-font;
        text: root.item.duration == "" ? root.item.ext : root.item.duration + "  ·  " + root.item.ext;
        opacity: ta.has-hover || remove.hovered ? 0 : 1;
        animate opacity { duration: T.quick; }
    }
    remove := GlyphButton {
        x: parent.width - self.width - 4px;
        size: 24px;
        glyph: 9px;
        bx: 6;
        by: 6;
        bw: 8;
        bh: 8;
        thickness: 1.45px;
        ink: T.muted;
        tip: root.remove-tip;
        commands: "M6,6 L14,14 M14,6 L6,14";
        opacity: ta.has-hover || self.hovered ? 1 : 0;
        animate opacity { duration: T.quick; }
        clicked => { root.remove(); }
    }
}

component MenuRow inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <string> commands;
    in property <float> bx: 3;
    in property <float> by: 3;
    in property <float> bw: 14;
    in property <float> bh: 14;
    in property <bool> active;
    callback activated;
    border-radius: 8px;
    background: ta.pressed ? T.glass-pressed : ta.has-hover ? T.glass-hover : transparent;
    animate background { duration: 90ms; }
    Glyph {
        x: 11px;
        width: 15px * root.bw / max(root.bw, root.bh);
        height: 15px * root.bh / max(root.bw, root.bh);
        commands: root.commands;
        bx: root.bx;
        by: root.by;
        bw: root.bw;
        bh: root.bh;
        thickness: 1.45px;
        color: root.active ? T.accent : T.icon-muted;
    }
    Text {
        x: 39px;
        text: root.text;
        color: T.text;
        font-size: 12.5px;
        vertical-alignment: center;
        height: parent.height;
    }
    Text {
        x: parent.width - self.width - 11px;
        text: root.active ? "✓" : root.hint;
        color: root.active ? T.accent : T.muted;
        font-size: root.active ? 13px : 11px;
        font-weight: root.active ? 600 : 400;
        height: parent.height;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.activated(); }
    }
}

export component AppWindow inherits Window {
    // ----- Platform -----
    in property <bool> frameless: true;
    in property <bool> mac: false;
    in property <length> min-w: T.full-min-width;
    in property <length> min-h: T.mini-height;

    // ----- Playback state -----
    in property <string> track-title;
    in property <string> track-subtitle;
    in property <bool> has-track;
    in property <bool> playing;
    in property <float> position-secs;
    in property <float> duration-secs;
    // Playback progress (0..1), updated by the app at the pace the bar needs to move
    // smoothly (a fraction of a pixel per frame), and the clock driving the queue's bars.
    in property <float> progress;
    in property <float> wave;
    // Opacity of the window content during a mode change (the container morphs while empty).
    in property <float> content-fade: 1;
    in property <bool> can-seek;
    // Remote mode: the window shows what another app plays (`remote-source`, e.g. "Spotify").
    in property <bool> remote;
    in property <string> remote-source;
    in property <bool> remote-mode: true;
    // No public API on macOS: the setting is not offered there.
    in property <bool> remote-available: true;
    in property <bool> can-prev: true;
    in property <bool> can-next: true;
    in property <float> volume: 0.82;
    in property <int> repeat-mode;
    in property <bool> topmost;
    in property <image> artwork;
    in property <bool> has-artwork;
    in property <color> tint: #00000000;
    // Two colours sampled from the artwork (top-left and bottom-right), for the ambient wash.
    in property <color> tint-a: T.ambient-warm;
    in property <color> tint-b: T.ambient-cool;
    // The ambient wash (see below), the previous one while they cross-fade, and a flag the
    // app raises for an instant when a new wash arrives.
    // The wordmark image and its size and position in logical pixels (whole physical ones).
    in property <image> wordmark;
    in property <length> wordmark-w;
    in property <length> wordmark-h;
    in property <length> wordmark-y;
    in property <image> ambient;
    in property <image> ambient-prev;
    in property <bool> ambient-fresh;
    // Test switch: 0 none, 1 wash only, 2 wash + grain (default).
    in property <int> ambient-level: 2;

    // ----- Queue -----
    in property <[QueueItem]> queue;
    in property <int> current-index: -1;
    in-out property <int> selected-index: -1;
    in property <bool> queue-open;
    // "7 tracks · 24 min", written by the app.
    in property <string> queue-summary;
    // Height given to the queue drawer; the app animates it with the window.
    in property <length> queue-extra;

    // ----- Misc -----
    in property <bool> dropping;
    in property <bool> morphing;

    // ----- Derived layout (read by the app) -----
    out property <length> compact-height: T.compact-height;
    out property <length> hero-min-height: T.hero-min-height;
    out property <length> mini-min-width: T.mini-min-width;
    out property <length> mini-height: T.mini-height;
    out property <length> queue-height: T.queue-height;
    out property <bool> queue-shown: root.queue-extra > 0 && root.height - root.queue-extra >= T.compact-height;
    out property <length> content-h: root.queue-shown ? root.height - root.queue-extra : root.height;
    out property <bool> mini: root.content-h < T.compact-height - 0.5px;

    callback toggle-play();
    callback previous();
    callback next();
    callback cycle-repeat();
    callback seek(float);
    callback nudge(float);
    callback set-volume(float);
    callback toggle-mute();
    callback toggle-queue();
    callback toggle-mini();
    callback toggle-topmost();
    callback minimize();
    callback quit();
    callback add-files();
    callback toggle-remote-mode();
    callback play-index(int);
    callback remove-index(int);
    callback clear-queue();
    callback move-item(int, int);
    // Ctrl+A selects the whole queue; Remove, Delete or "-" then clear it.
    in-out property <bool> select-all;
    in-out property <bool> show-remaining;
    callback start-drag();

    title: root.has-track ? "Listen — " + root.track-title : "Listen";
    icon: @image-url("../assets/icon-64.png");
    background: T.bg;
    no-frame: root.frameless;
    resize-border-width: root.frameless ? 6px : 0px;
    always-on-top: root.topmost || root.mini;
    preferred-width: 500px;
    preferred-height: 410px;
    min-width: root.min-w;
    min-height: root.min-h;
    default-font-family: T.ui-font;

    property <float> to-hero: clamp((root.content-h - T.hero-min-height) / T.fade-band, 0, 1);
    property <float> hero-opacity: clamp(root.to-hero * 2 - 1, 0, 1);
    property <float> compact-opacity: root.content-h < T.hero-min-height ? 1 : clamp(1 - root.to-hero * 2, 0, 1);
    property <float> art-opacity: clamp((root.content-h - T.hero-min-height - T.artwork-fade-start) / T.fade-band, 0, 1);
    property <bool> tight: root.width - T.mini-min-width < T.mini-title-min-space;
    property <float> shown-progress: clamp(root.progress, 0, 1);
    property <string> shortcut: root.mac ? "⌘" : "Ctrl+";

    // Track change: the shown title and subtitle trail the real ones through a short
    // cross-fade with a slight rise, instead of jumping.
    property <string> shown-title: root.has-track ? root.track-title : root.s-nothing;
    property <string> shown-subtitle: root.track-subtitle;
    property <float> swap: 1;
    animate swap { duration: 150ms; easing: ease-out; }
    property <bool> swapping;
    property <string> next-title: root.has-track ? root.track-title : root.s-nothing;
    property <string> next-key: root.next-title + " | " + root.track-subtitle;
    // The queue follows playback: on each track change it glides to centre the playing row.
    changed current-index => { root.reveal-current(); }
    changed queue-shown => { root.reveal-current(); }
    function reveal-current() {
        if (root.current-index < 0 || !root.queue-shown) { return; }
        list.content-y = -clamp(root.current-index * 34px - (list.height - 32px) / 2, 0px, max(0px, list.content-height - list.height));
    }
    changed next-key => {
        root.swapping = true;
        root.swap = 0;
    }
    Timer {
        interval: 150ms;
        running: root.swapping;
        triggered => {
            root.shown-title = root.next-title;
            root.shown-subtitle = root.track-subtitle;
            root.swapping = false;
            root.swap = 1;
        }
    }

    // Strings
    property <string> s-nothing: L.fr ? "Aucun titre" : "Nothing playing";
    property <string> s-add-hint: L.fr ? "Ajouter un fichier ou le glisser ici" : "Add a file or drop it here";
    property <string> s-topmost: L.fr ? "Toujours au-dessus" : "Always on top";
    property <string> s-mini: L.fr ? "Mode mini" : "Mini player";
    property <string> s-queue: L.fr ? "File d’attente" : "Play queue";
    property <string> s-show-queue: L.fr ? "Afficher la file d’attente" : "Show play queue";
    property <string> s-add-files: L.fr ? "Ajouter des fichiers…" : "Add audio files…";
    property <string> s-quit: L.fr ? "Quitter" : "Quit";
    property <string> s-remote-mode: L.fr ? "Suivre les autres apps" : "Follow other apps";
    property <string> s-remote-tip: L.fr ? "En lecture dans " + root.remote-source : "Playing in " + root.remote-source;
    // "Artist · Spotify": where the source is not shown on its own.
    property <string> with-source: root.shown-subtitle == "" ? root.remote-source : root.shown-subtitle + "  ·  " + root.remote-source;
    // Listen's own controls that do not apply to another app fade out while mirroring.
    property <float> own-controls: root.remote ? 0 : 1;
    animate own-controls { duration: T.medium; easing: ease-out; }
    property <string> s-repeat: root.repeat-mode == 1 ? (L.fr ? "Répéter la file d’attente" : "Repeat play queue") : root.repeat-mode == 2 ? (L.fr ? "Répéter ce titre" : "Repeat this track") : (L.fr ? "Répétition désactivée" : "Repeat off");


    // ---- Ambient wash: the artwork's colours bleed softly into the window, like light
    // through frosted glass. A quiet warm/cool duotone when there is no artwork.
    property <color> amb-a: root.has-artwork ? root.tint-a : T.ambient-warm;
    property <color> amb-b: root.has-artwork ? root.tint-b : T.ambient-cool;
    animate amb-a, amb-b { duration: 900ms; easing: ease-in-out; }
    property <float> amb-strength: root.has-artwork ? (root.playing ? 0.5 : 0.36) : 0.42;
    animate amb-strength { duration: 900ms; easing: ease-in-out; }
    // The wash is a small image the app renders once per track (two soft glows) and the
    // window stretches smoothly: far cheaper to draw than full-window radial gradients,
    // which matters when a morph repaints the whole window on every step.
    property <float> ambient-mix: root.ambient-fresh ? 0 : 1;
    animate ambient-mix { duration: root.ambient-fresh ? 0ms : 900ms; easing: ease-in-out; }
    Image {
        width: root.width;
        height: root.height;
        source: root.ambient-prev;
        image-fit: fill;
        image-rendering: smooth;
        opacity: root.amb-strength * (1 - root.ambient-mix);
        visible: root.ambient-level >= 1 && self.opacity > 0.005;
    }
    Image {
        width: root.width;
        height: root.height;
        source: root.ambient;
        image-fit: fill;
        image-rendering: smooth;
        opacity: root.amb-strength * root.ambient-mix;
        visible: root.ambient-level >= 1;
    }
    // A fine grain over the wash, so its very soft gradients never show steps.
    Image {
        width: root.width;
        height: root.height;
        source: @image-url("../assets/grain.png");
        horizontal-tiling: repeat;
        vertical-tiling: repeat;
        // Skipped while the window morphs: every step repaints the whole window, and each
        // frame must be ready within one display refresh.
        visible: !root.morphing && root.ambient-level >= 2;
        opacity: 0.045;
    }

    fs := FocusScope {
        opacity: root.content-fade;
        // Fully dissolved during a mode change: not drawn at all, so each morph step paints
        // fast enough to be on screen before the window's new size is.
        visible: root.content-fade > 0.001;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.modifiers.control || e.modifiers.meta) {
                if (e.text == "o" || e.text == "O") { root.add-files(); return accept; }
                if ((e.text == "a" || e.text == "A") && root.queue.length > 0) {
                    if (!root.queue-open) { root.toggle-queue(); }
                    root.select-all = true;
                    return accept;
                }
                if (e.text == "m" || e.text == "M") { root.toggle-mini(); return accept; }
                if (e.text == "t" || e.text == "T") { root.toggle-topmost(); return accept; }
                if (e.text == "l" || e.text == "L") { root.toggle-queue(); return accept; }
                if (e.text == "r" || e.text == "R") { root.cycle-repeat(); return accept; }
                if (e.text == "q" || e.text == "Q" || e.text == "w" || e.text == "W") { root.quit(); return accept; }
                return reject;
            }
            if (e.text == " ") { root.toggle-play(); return accept; }
            if (e.text == Key.LeftArrow) { root.nudge(-5); return accept; }
            if (e.text == Key.RightArrow) { root.nudge(5); return accept; }
            if (e.text == Key.UpArrow) { root.set-volume(min(1, root.volume + 0.05)); return accept; }
            if (e.text == Key.DownArrow) { root.set-volume(max(0, root.volume - 0.05)); return accept; }
            if (e.text == "+" || e.text == "=") { root.add-files(); return accept; }
            if ((e.text == Key.Delete || e.text == "-") && root.queue-shown) {
                if (root.select-all) {
                    root.select-all = false;
                    root.clear-queue();
                } else if (root.selected-index >= 0) {
                    root.remove-index(root.selected-index);
                }
                return accept;
            }
            if (e.text == Key.Escape && root.select-all) { root.select-all = false; return accept; }
            if (e.text == Key.Return && root.queue-shown && root.selected-index >= 0) { root.play-index(root.selected-index); return accept; }
            if (e.text == Key.Escape && root.mini) { root.toggle-mini(); return accept; }
            reject
        }

        // ================= Full player =================
        full := Rectangle {
            visible: !root.mini;
            opacity: root.mini ? 0 : 1;
            animate opacity { duration: 160ms; easing: ease-out; }
            property <length> seek-y: root.content-h - T.controls-row - T.seek-row;
            property <length> controls-y: root.content-h - T.controls-row;

            DragSurface {
                height: full.seek-y;
                y: 0;
                start-drag => { root.start-drag(); }
            }

            // ---- Title bar ----
            // The mark: a silver disc with a sound wave carved through it (the app icon).
            Rectangle {
                x: 12px;
                y: (T.top-bar - self.height) / 2 + 1px;
                width: 24px;
                height: 24px;
                border-radius: self.width / 2;
                background: @linear-gradient(150deg, #FFFFFF 0%, #E4E4E8 55%, #9E9EA4 100%);
                clip: true;
                opacity: root.hero-opacity;
                // Sound when playing, silence when paused: the wave flattens to a line.
                property <float> amp: root.playing ? 1 : 0.02;
                animate amp { duration: 560ms; easing: M.spring; }
                Rectangle {
                    x: 0;
                    width: parent.width;
                    height: 1.7px;
                    background: #0E0E0F;
                    opacity: clamp((1 - parent.amp) * 1.4 - 0.2, 0, 1);
                }
                Path {
                    width: parent.width;
                    height: parent.height * max(parent.amp, 0.15);
                    y: (parent.height - self.height) / 2;
                    opacity: clamp((parent.amp - 0.1) / 0.6, 0, 1);
                    viewbox-width: 100;
                    viewbox-height: 100;
                    stroke: #0E0E0F;
                    stroke-width: 1.7px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    fill: transparent;
                    commands: "M0.0,50.0 L0.8,50.0 L1.7,50.0 L2.5,50.0 L3.3,49.9 L4.2,49.8 L5.0,49.7 L5.8,49.5 L6.7,49.3 L7.5,49.1 L8.3,49.0 L9.2,48.8 L10.0,48.7 L10.8,48.7 L11.7,48.8 L12.5,49.0 L13.3,49.4 L14.2,49.9 L15.0,50.6 L15.8,51.4 L16.7,52.3 L17.5,53.3 L18.3,54.3 L19.2,55.3 L20.0,56.2 L20.8,57.0 L21.7,57.6 L22.5,57.9 L23.3,57.9 L24.2,57.6 L25.0,56.9 L25.8,55.9 L26.7,54.4 L27.5,52.7 L28.3,50.6 L29.2,48.4 L30.0,45.9 L30.8,43.5 L31.7,41.0 L32.5,38.8 L33.3,36.7 L34.2,35.1 L35.0,33.9 L35.8,33.2 L36.7,33.2 L37.5,33.7 L38.3,34.9 L39.2,36.6 L40.0,38.9 L40.8,41.8 L41.7,45.0 L42.5,48.5 L43.3,52.1 L44.2,55.7 L45.0,59.3 L45.8,62.5 L46.7,65.4 L47.5,67.8 L48.3,69.5 L49.2,70.6 L50.0,71.0 L50.8,70.6 L51.7,69.5 L52.5,67.8 L53.3,65.4 L54.2,62.5 L55.0,59.3 L55.8,55.7 L56.7,52.1 L57.5,48.5 L58.3,45.0 L59.2,41.8 L60.0,38.9 L60.8,36.6 L61.7,34.9 L62.5,33.7 L63.3,33.2 L64.2,33.2 L65.0,33.9 L65.8,35.1 L66.7,36.7 L67.5,38.8 L68.3,41.0 L69.2,43.5 L70.0,45.9 L70.8,48.4 L71.7,50.6 L72.5,52.7 L73.3,54.4 L74.2,55.9 L75.0,56.9 L75.8,57.6 L76.7,57.9 L77.5,57.9 L78.3,57.6 L79.2,57.0 L80.0,56.2 L80.8,55.3 L81.7,54.3 L82.5,53.3 L83.3,52.3 L84.2,51.4 L85.0,50.6 L85.8,49.9 L86.7,49.4 L87.5,49.0 L88.3,48.8 L89.2,48.7 L90.0,48.7 L90.8,48.8 L91.7,49.0 L92.5,49.1 L93.3,49.3 L94.2,49.5 L95.0,49.7 L95.8,49.8 L96.7,49.9 L97.5,50.0 L98.3,50.0 L99.2,50.0 L100.0,50.0";
                }
            }
            // Wordmark: rendered by the app at the screen's exact pixel size, stems on the
            // pixel grid (see wordmark.rs), and shown 1:1 so it stays crisp.
            Image {
                x: 44px;
                y: root.wordmark-y;
                width: root.wordmark-w;
                height: root.wordmark-h;
                source: root.wordmark;
                image-rendering: pixelated;
                opacity: root.hero-opacity;
            }
            // Remote mode: whose playback the window shows, beside the wordmark.
            source-pill := DragSurface {
                property <float> shown: root.remote ? 1 : 0;
                animate shown { duration: T.slow; easing: M.spring; }
                x: 44px + root.wordmark-w + 11px;
                y: (T.top-bar - self.height) / 2 + 1px;
                height: 22px;
                width: min(pill-row.preferred-width + 18px, window-buttons.x - self.x - 8px);
                opacity: root.hero-opacity * self.shown;
                visible: self.opacity > 0.01 && self.width > 44px;
                start-drag => { root.start-drag(); }
                Rectangle {
                    border-radius: self.height / 2;
                    background: T.glass-raised;
                    border-width: 1px;
                    border-color: T.hairline;
                    clip: true;
                    pill-row := HorizontalLayout {
                        x: 8px;
                        width: parent.width - 16px;
                        spacing: 5px;
                        alignment: start;
                        Glyph {
                            y: (parent.height - self.height) / 2;
                            width: 13px;
                            height: 10px;
                            bx: 1;
                            by: 3;
                            bw: 18;
                            bh: 14;
                            thickness: 1.3px;
                            color: T.secondary;
                            commands: "M7,6.5 C5,8.5 5,11.5 7,13.5 M13,6.5 C15,8.5 15,11.5 13,13.5 M4.5,4 C1.2,7.3 1.2,12.7 4.5,16 M15.5,4 C18.8,7.3 18.8,12.7 15.5,16 M10,9.7 L10,10.3";
                        }
                        Text {
                            text: root.remote-source;
                            color: T.secondary;
                            font-size: 11px;
                            font-weight: 500;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
                TipSource {
                    tip: root.s-remote-tip;
                    hovered: source-pill.has-hover;
                    pressed: source-pill.pressed;
                    anchor-x: source-pill.absolute-position.x + source-pill.width / 2;
                    anchor-top: source-pill.absolute-position.y;
                    anchor-bottom: source-pill.absolute-position.y + source-pill.height;
                }
            }
            compact-title := VerticalLayout {
                x: 14px;
                y: 4px;
                width: window-buttons.x - self.x - 10px;
                height: T.top-bar - 6px;
                alignment: center;
                visible: root.compact-opacity > 0;
                opacity: root.compact-opacity;
                Text {
                    text: root.shown-title;
                    opacity: root.swap;
                    color: T.text;
                    font-size: 14px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.has-track ? (root.remote ? root.with-source : root.shown-subtitle) : root.s-add-hint;
                    // No artist known: the title alone, centred in the bar.
                    height: self.text == "" ? 0px : self.preferred-height;
                    opacity: root.swap;
                    color: T.muted;
                    font-size: 11px;
                    overflow: elide;
                }
            }
            window-buttons := HorizontalLayout {
                width: 4 * 30px + 3 * 2px;
                x: parent.width - self.width - 8px;
                y: (T.top-bar - 30px) / 2 + 1px;
                height: 30px;
                spacing: 2px;
                GlyphButton {
                    tip: root.s-topmost;
                    commands: "M5,7 L14,7 L14,16 L5,16 Z M8,4 L17,4 L17,13";
                    bx: 5;
                    by: 4;
                    bw: 12;
                    bh: 12;
                    glyph: 15px;
                    ink: root.topmost ? T.toggle-on : T.toggle-off;
                    active: root.topmost;
                    clicked => { root.toggle-topmost(); }
                }
                GlyphButton {
                    tip: root.s-mini;
                    commands: "M4,6 L16,6 L16,14 L4,14 Z M7,11 L13,11";
                    bx: 4;
                    by: 6;
                    bw: 12;
                    bh: 8;
                    glyph: 15px;
                    clicked => { root.toggle-mini(); }
                }
                GlyphButton {
                    tip: L.fr ? "Réduire" : "Minimize";
                    commands: "M5,10 L15,10";
                    bx: 5;
                    by: 5;
                    bw: 10;
                    bh: 10;
                    glyph: 11px;
                    clicked => { root.minimize(); }
                }
                close-button := GlyphButton {
                    tip: L.fr ? "Fermer" : "Close";
                    commands: "M6,6 L14,14 M14,6 L6,14";
                    bx: 6;
                    by: 6;
                    bw: 8;
                    bh: 8;
                    glyph: 10px;
                    ink: self.hovered ? #FFFFFF : T.text;
                    rest: transparent;
                    clicked => { root.quit(); }
                }
            }

            // ---- Hero: artwork, title, subtitle ----
            hero := Rectangle {
                x: 22px;
                y: T.top-bar + 14px;
                width: parent.width - 44px;
                height: max(0px, full.seek-y - self.y - 4px);
                visible: root.content-h >= T.hero-min-height && root.hero-opacity > 0;
                opacity: root.hero-opacity;
                property <length> art-room: max(0px, self.height - T.title-block);
                property <length> art-base: min(T.artwork, self.art-room);
                // The artwork rests a little smaller while paused.
                property <float> rest-scale: root.playing || !root.has-track ? 1 : 0.9;
                animate rest-scale { duration: 520ms; easing: M.spring; }

                // Soft halo in the artwork's own colour.
                Rectangle {
                    width: hero.art-base * 2.3;
                    height: hero.art-base * 1.7;
                    y: (hero.art-room - self.height) / 2;
                    opacity: root.art-opacity * (root.has-artwork ? (root.playing ? 0.7 : 0.4) : 0.25);
                    animate opacity { duration: 600ms; easing: ease-in-out; }
                    background: @radial-gradient(circle, root.amb-a 0%, transparent 62%);
                }
                art := Rectangle {
                    width: hero.art-base * hero.rest-scale;
                    height: self.width;
                    y: (hero.art-room - self.height) / 2;
                    visible: root.art-opacity > 0 && self.width > 4px;
                    opacity: root.art-opacity * (0.4 + 0.6 * root.swap);
                    border-radius: 20px * self.width / T.artwork;
                    background: @linear-gradient(155deg, #FFFFFF17 0%, #FFFFFF07 55%, #FFFFFF03 100%);
                    border-width: root.has-artwork ? 0px : 1px;
                    border-color: T.hairline;
                    drop-shadow-blur: 22px * self.width / T.artwork;
                    drop-shadow-offset-y: 8px * self.width / T.artwork;
                    drop-shadow-color: root.has-artwork ? #00000080 : #00000040;
                    clip: true;
                    Text {
                        opacity: root.has-artwork ? 0 : 1;
                        animate opacity { duration: 260ms; easing: ease-out; }
                        text: "♪";
                        color: T.art-text;
                        font-size: 54px * art.width / T.artwork;
                    }
                    Image {
                        opacity: root.has-artwork ? 1 : 0;
                        visible: self.opacity > 0.01;
                        animate opacity { duration: 260ms; easing: ease-out; }
                        width: parent.width;
                        height: parent.height;
                        source: root.artwork;
                        image-fit: cover;
                        image-rendering: smooth;
                    }
                }
                Text {
                    y: hero.height - T.title-block + 10px + (1 - root.swap) * 6px;
                    opacity: root.swap;
                    width: parent.width;
                    height: 32px;
                    text: root.shown-title;
                    color: T.text;
                    font-size: 22px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.has-track: Text {
                    y: hero.height - 30px + (1 - root.swap) * 6px;
                    opacity: root.swap;
                    width: parent.width;
                    height: 30px;
                    text: root.shown-subtitle;
                    color: T.muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if !root.has-track: AddHint {
                    y: hero.height - 30px;
                    text: root.s-add-hint;
                    clicked => { root.add-files(); }
                }
                DropOverlay {
                    active: root.dropping;
                    title: L.fr ? "Déposez l’audio ici" : "Drop audio here";
                    subtitle: L.fr ? "Ajout à la file · lecture immédiate si vide" : "Adds to queue · plays immediately when empty";
                }
            }
            // A compact window still shows where to drop.
            DropOverlay {
                x: 12px;
                y: 6px;
                width: parent.width - 24px;
                height: max(0px, full.seek-y - 6px);
                compact: true;
                active: root.dropping && !hero.visible;
                title: L.fr ? "Déposez l’audio ici" : "Drop audio here";
                subtitle: L.fr ? "Ajout à la file" : "Adds to the queue";
            }

            // ---- Seek row ----
            seek-row := Rectangle {
                x: 22px;
                y: full.seek-y + 12px;
                width: parent.width - 44px;
                height: 26px;
                elapsed := Text {
                    x: 0;
                    width: max(48px, self.preferred-width);
                    height: parent.height;
                    vertical-alignment: center;
                    font-family: T.time-font;
                    font-size: 13px;
                    font-weight: 500;
                    color: seek.dragging ? T.text : T.time;
                    text: Fmt.clock(seek.dragging ? seek.shown * root.duration-secs : root.position-secs);
                }
                total := Text {
                    x: parent.width - self.width;
                    width: max(48px, self.preferred-width);
                    height: parent.height;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    font-family: T.time-font;
                    font-size: 13px;
                    font-weight: 500;
                    color: total-ta.has-hover ? T.text : T.time;
                    animate color { duration: T.quick; }
                    text: root.duration-secs <= 0 ? "00:00"
                        : root.show-remaining ? "−" + Fmt.clock(max(0, root.duration-secs - floor(root.position-secs)))
                        : Fmt.clock(root.duration-secs);
                    total-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.show-remaining = !root.show-remaining; }
                    }
                }
                seek := Slider {
                    x: elapsed.width + 10px;
                    width: parent.width - 2 * (elapsed.width + 10px);
                    height: 26px;
                    enabled: root.can-seek;
                    value: root.shown-progress;
                    commit(v) => { root.seek(v); }
                }
                // Time under the pointer.
                Rectangle {
                    property <bool> on: (seek.hovered || seek.dragging) && root.can-seek;
                    x: seek.x + clamp(seek.hover-x, 0, seek.width) - self.width / 2;
                    y: -24px;
                    width: tip-time.preferred-width + 14px;
                    height: 20px;
                    border-radius: 6px;
                    background: #1E1E1EF0;
                    border-width: 1px;
                    border-color: T.hairline;
                    opacity: self.on ? 1 : 0;
                    animate opacity { duration: T.quick; }
                    tip-time := Text {
                        text: Fmt.clock((seek.dragging ? seek.shown : seek.hover-value) * root.duration-secs);
                        color: T.text;
                        font-family: T.time-font;
                        font-size: 11px;
                    }
                }
            }

            // ---- Controls row ----
            controls := Rectangle {
                x: 18px;
                y: full.controls-y + 4px;
                width: parent.width - 36px;
                height: 52px;
                property <bool> show-volume-slider: root.width >= T.volume-slider-min-width;

                volume-button := GlyphButton {
                    x: 0;
                    size: 32px;
                    // Listen's volume: no use on another app's sound.
                    enabled: !root.remote;
                    opacity: 0.3 + 0.7 * root.own-controls;
                    glyph: 18px;
                    tip: root.volume <= 0.001 ? (L.fr ? "Rétablir le son" : "Unmute") : (L.fr ? "Muet" : "Mute");
                    bx: 3.5;
                    by: 3.5;
                    bw: 17;
                    bh: 13;
                    commands: root.volume <= 0.001
                        ? "M4,8 L8,8 L12,4 L12,16 L8,12 L4,12 Z M15,8 L19,12 M19,8 L15,12"
                        : root.volume < 0.45
                            ? "M4,8 L8,8 L12,4 L12,16 L8,12 L4,12 Z M15,8 C16.5,9 16.5,11 15,12"
                            : "M4,8 L8,8 L12,4 L12,16 L8,12 L4,12 Z M15,8 C16.5,9 16.5,11 15,12 M17,6 C20,8 20,12 17,14";
                    clicked => { root.toggle-mute(); }
                }
                volume-slider := Slider {
                    x: volume-button.width + 5px;
                    width: 88px;
                    height: 24px;
                    visible: controls.show-volume-slider;
                    enabled: !root.remote;
                    opacity: 0.3 + 0.7 * root.own-controls;
                    wheel: true;
                    fill: #DADADA;
                    value: root.volume;
                    scrub(v) => { root.set-volume(v); }
                    commit(v) => { root.set-volume(v); }
                }
                // Level bubble while the volume is being changed.
                Rectangle {
                    property <bool> on: controls.show-volume-slider && (volume-slider.hovered || volume-slider.dragging);
                    x: volume-slider.x + 7px + (volume-slider.width - 14px) * root.volume - self.width / 2;
                    y: -14px;
                    width: vol-text.preferred-width + 14px;
                    height: 20px;
                    border-radius: 6px;
                    background: #1E1E1EF0;
                    border-width: 1px;
                    border-color: T.hairline;
                    opacity: self.on ? 1 : 0;
                    animate opacity { duration: T.quick; }
                    vol-text := Text {
                        text: round(root.volume * 100) + " %";
                        color: T.text;
                        font-family: T.time-font;
                        font-size: 11px;
                    }
                }

                // Play sits on the window's centre whenever the side groups leave room.
                property <length> left-end: controls.show-volume-slider ? 32px + 5px + 88px : 32px;
                property <length> right-start: right-group.x;
                property <length> stack-left: 42px + 6px;
                property <length> stack-right: 6px + 42px + 2px + 32px;
                property <length> ideal: self.width / 2;
                property <length> centre: clamp(self.ideal, self.left-end + 8px + self.stack-left + 26px, self.right-start - 8px - self.stack-right - 26px);

                SkipButton {
                    x: controls.centre - 26px - 6px - self.width;
                    size: 42px;
                    tip: L.fr ? "Précédent" : "Previous";
                    enabled: root.can-prev;
                    clicked => { root.previous(); }
                }
                PlayButton {
                    x: controls.centre - 26px;
                    size: 52px;
                    glyph: 19px;
                    playing: root.playing;
                    tip: L.fr ? "Lecture / pause" : "Play / pause";
                    clicked => { root.toggle-play(); }
                }
                SkipButton {
                    x: controls.centre + 26px + 6px;
                    size: 42px;
                    forward: true;
                    tip: L.fr ? "Suivant" : "Next";
                    enabled: root.can-next;
                    clicked => { root.next(); }
                }
                RepeatButton {
                    x: controls.centre + 26px + 6px + 42px + 2px;
                    y: (parent.height - self.height) / 2;
                    size: 32px;
                    mode: root.repeat-mode;
                    enabled: !root.remote;
                    opacity: root.own-controls;
                    visible: self.opacity > 0.01;
                    tip: root.s-repeat;
                    clicked => { root.cycle-repeat(); }
                }

                right-group := HorizontalLayout {
                    width: 2 * 32px + 2px;
                    x: parent.width - self.width;
                    height: 32px;
                    spacing: 2px;
                    GlyphButton {
                        size: 32px;
                        glyph: 15px;
                        tip: root.s-queue;
                        bx: 5;
                        by: 6;
                        bw: 10;
                        bh: 8;
                        ink: root.queue-open ? T.toggle-on : T.toggle-off;
                        active: root.queue-open;
                        commands: "M5,6 L15,6 M5,10 L15,10 M5,14 L15,14";
                        clicked => { root.toggle-queue(); }
                    }
                    more := DotsButton {
                        size: 32px;
                        tip: L.fr ? "Plus" : "More";
                        clicked => {
                            menu.show();
                        }
                    }
                }
            }

            // ---- Queue drawer ----
            drawer := Rectangle {
                y: root.content-h;
                height: root.queue-shown ? root.queue-extra : 0px;
                clip: true;
                Rectangle {
                    y: 0;
                    height: T.queue-height;
                    background: @linear-gradient(180deg, #FFFFFF0C 0%, #FFFFFF05 100%);
                    Rectangle {
                        y: 0;
                        height: 1px;
                        background: T.hairline;
                    }
                    // Header
                    HorizontalLayout {
                        x: 20px;
                        y: 9px;
                        width: parent.width - 36px;
                        height: 30px;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;
                            Text {
                                text: root.s-queue;
                                color: T.text;
                                font-size: 12.5px;
                                font-weight: 600;
                            }
                            Text {
                                text: root.queue-summary;
                                color: T.muted;
                                font-size: 10.5px;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        PillButton {
                            y: (parent.height - self.height) / 2;
                            text: L.fr ? "Ajouter" : "Add";
                            icon: "M10,4.5 L10,15.5 M4.5,10 L15.5,10";
                            tip: L.fr ? "Ajouter des fichiers audio" : "Add audio files";
                            clicked => { root.add-files(); }
                        }
                        PillButton {
                            y: (parent.height - self.height) / 2;
                            text: L.fr ? "Retirer" : "Remove";
                            icon: "M4.5,10 L15.5,10";
                            tip: L.fr ? "Retirer le titre sélectionné" : "Remove the selected track";
                            enabled: root.select-all || (root.selected-index >= 0 && root.selected-index < root.queue.length);
                            clicked => {
                                if (root.select-all) {
                                    root.select-all = false;
                                    root.clear-queue();
                                } else {
                                    root.remove-index(root.selected-index);
                                }
                            }
                        }
                        PillButton {
                            y: (parent.height - self.height) / 2;
                            text: L.fr ? "Vider" : "Clear";
                            icon: "M5,6.5 L15,6.5 M8.2,6.5 L8.2,4.8 L11.8,4.8 L11.8,6.5 M6.5,6.5 L7.2,15.5 L12.8,15.5 L13.5,6.5";
                            tip: L.fr ? "Vider la file d’attente" : "Clear the play queue";
                            enabled: root.queue.length > 0;
                            clicked => { root.clear-queue(); }
                        }
                    }
                    // List
                    list-area := Rectangle {
                        x: 14px;
                        y: 42px;
                        width: parent.width - 28px;
                        height: T.queue-height - 42px - 10px;
                        list := Flickable {
                            property <int> drag-from: -1;
                            property <length> drag-dy;
                            property <int> target: self.drag-from < 0 ? -1 : clamp(round((self.drag-from * 34px + self.drag-dy) / 34px), 0, root.queue.length - 1);
                            interactive: self.drag-from < 0;
                            width: parent.width - 12px;
                            // Glides (wheel scrolling too) instead of jumping.
                            animate content-y { duration: 320ms; easing: M.settle; }
                            x: 0;
                            content-height: max(self.height, root.queue.length * 34px);
                            for item[i] in root.queue: QueueRow {
                                // Reordering: the lifted row follows the pointer; the rows it
                                // passes slide out of its way.
                                property <int> target: list.target;
                                property <length> rest: (list.drag-from < 0 ? i
                                    : i == list.drag-from ? i
                                    : list.drag-from < self.target && i > list.drag-from && i <= self.target ? i - 1
                                    : list.drag-from > self.target && i >= self.target && i < list.drag-from ? i + 1
                                    : i) * 34px;
                                animate rest { duration: 180ms; easing: M.settle; }
                                y: i == list.drag-from ? i * 34px + list.drag-dy : self.rest;
                                z: i == list.drag-from ? 1 : 0;
                                lifted: i == list.drag-from;
                                drag-move(dy) => {
                                    list.drag-from = i;
                                    list.drag-dy = dy;
                                }
                                drag-end => {
                                    if (list.target != list.drag-from) {
                                        root.move-item(list.drag-from, list.target);
                                    }
                                    list.drag-from = -1;
                                    list.drag-dy = 0;
                                }
                                width: list.width;
                                item: item;
                                current: i == root.current-index;
                                selected: root.select-all || i == root.selected-index;
                                playing: root.playing;
                                wave: root.wave;
                                remove-tip: L.fr ? "Retirer" : "Remove";
                                select => {
                                    root.select-all = false;
                                    root.selected-index = i;
                                    fs.focus();
                                }
                                activate => { root.play-index(i); }
                                remove => { root.remove-index(i); }
                            }
                        }
                        // Overlay scrollbar
                        Rectangle {
                            property <float> span: list.content-height > list.height ? list.height / list.content-height : 1;
                            property <bool> hot: bar-ta.has-hover || bar-ta.pressed;
                            x: parent.width - 7px;
                            width: 8px;
                            visible: self.span < 1;
                            bar-ta := TouchArea {
                                property <length> grab;
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down) {
                                        self.grab = self.mouse-y - thumb.y;
                                    }
                                }
                                moved => {
                                    if (self.pressed) {
                                        list.content-y = -clamp((self.mouse-y - self.grab) / max(1px, parent.height - thumb.height), 0, 1) * (list.content-height - list.height);
                                    }
                                }
                            }
                            thumb := Rectangle {
                                x: (parent.width - self.width) / 2;
                                width: parent.hot ? 6px : 3px;
                                height: max(24px, parent.height * parent.span);
                                y: (parent.height - self.height) * (-list.content-y / max(1px, list.content-height - list.height));
                                border-radius: self.width / 2;
                                background: bar-ta.pressed ? #8A8A8A : parent.hot ? T.scroll-thumb-hover : T.scroll-thumb;
                                animate width, background { duration: T.quick; }
                            }
                        }
                        if root.queue.length == 0: AddHint {
                            text: L.fr ? "Glissez des fichiers audio ici" : "Drop audio files here";
                            font: 11px;
                            clicked => { root.add-files(); }
                        }
                        DropOverlay {
                            compact: true;
                            active: root.dropping;
                            title: L.fr ? "Déposez pour ajouter" : "Drop to add";
                            subtitle: L.fr ? "Ajouter à la file d’attente" : "Add to play queue";
                        }
                    }
                }
            }
        }

        // ================= Mini player =================
        mini := Rectangle {
            visible: root.mini;
            opacity: root.mini ? 1 : 0;
            animate opacity { duration: 160ms; easing: ease-out; }
            property <length> left: root.tight ? T.mini-tight-left : T.mini-left;
            property <length> row-h: root.content-h - 10px - 18px;

            DragSurface {
                height: root.content-h;
                start-drag => { root.start-drag(); }
                double-clicked => { root.toggle-mini(); }
            }
            Text {
                x: mini.left;
                y: 5px;
                width: max(0px, mini-controls.x - self.x - 10px);
                height: mini.row-h;
                vertical-alignment: center;
                text: !root.has-track ? "Listen" : root.remote ? root.shown-title + "  ·  " + root.remote-source : root.shown-title;
                color: T.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
                opacity: root.tight ? 0 : root.swap;
                animate opacity { duration: T.quick; }
            }
            mini-controls := HorizontalLayout {
                width: T.mini-controls;
                x: parent.width - self.width - T.mini-right;
                y: 5px + (mini.row-h - self.height) / 2;
                height: 44px;
                padding-left: 2px;
                spacing: 4px;
                alignment: center;
                SkipButton {
                    y: (parent.height - self.height) / 2;
                    size: 34px;
                    glyph: 17px;
                    tip: L.fr ? "Précédent" : "Previous";
                    enabled: root.can-prev;
                    clicked => { root.previous(); }
                }
                PlayButton {
                    y: (parent.height - self.height) / 2;
                    size: 40px;
                    glyph: 20px;
                    playing: root.playing;
                    tip: L.fr ? "Lecture / pause" : "Play / pause";
                    clicked => { root.toggle-play(); }
                }
                SkipButton {
                    y: (parent.height - self.height) / 2;
                    size: 34px;
                    glyph: 17px;
                    forward: true;
                    tip: L.fr ? "Suivant" : "Next";
                    enabled: root.can-next;
                    clicked => { root.next(); }
                }
                RepeatButton {
                    y: (parent.height - self.height) / 2;
                    size: 24px;
                    small: true;
                    mode: root.repeat-mode;
                    enabled: !root.remote;
                    opacity: root.own-controls;
                    visible: self.opacity > 0.01;
                    tip: root.s-repeat;
                    clicked => { root.cycle-repeat(); }
                }
                GlyphButton {
                    y: (parent.height - self.height) / 2;
                    size: 24px;
                    glyph: 12px;
                    bx: 0;
                    by: 0;
                    bw: 8;
                    bh: 8;
                    thickness: 1.65px;
                    tip: L.fr ? "Agrandir" : "Expand";
                    commands: "M2.7,5.3 L8,0 M5,0 L8,0 L8,3 M5.3,2.7 L0,8 M0,5 L0,8 L3,8";
                    clicked => { root.toggle-mini(); }
                }
            }
            // Progress
            Rectangle {
                property <length> inset: root.tight ? T.mini-right + 1px - mini.left : 0px;
                x: mini.left + self.inset;
                y: root.content-h - 5px - 18px;
                width: parent.width - mini.left - T.mini-right - 1px - self.inset;
                height: 18px;
                Text {
                    x: 0;
                    width: 39px;
                    height: parent.height;
                    vertical-alignment: center;
                    font-family: T.time-font;
                    font-size: 11.5px;
                    font-weight: 500;
                    color: mini-seek.dragging ? T.text : T.time;
                    text: Fmt.clock(mini-seek.dragging ? mini-seek.shown * root.duration-secs : root.position-secs);
                }
                mini-seek := Slider {
                    x: 42px;
                    width: parent.width - 84px;
                    height: parent.height;
                    show-thumb: false;
                    track: 3px;
                    enabled: root.can-seek;
                    value: root.shown-progress;
                    commit(v) => { root.seek(v); }
                }
                Text {
                    x: parent.width - self.width;
                    width: 39px;
                    height: parent.height;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    font-family: T.time-font;
                    font-size: 11.5px;
                    font-weight: 500;
                    color: mini-total-ta.has-hover ? T.text : T.time;
                    text: root.duration-secs <= 0 ? "00:00"
                        : root.show-remaining ? "−" + Fmt.clock(max(0, root.duration-secs - floor(root.position-secs)))
                        : Fmt.clock(root.duration-secs);
                    mini-total-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.show-remaining = !root.show-remaining; }
                    }
                }
            }
            DropOverlay {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: root.content-h - 8px;
                compact: true;
                active: root.dropping;
                title: L.fr ? "Déposez pour ajouter" : "Drop to add";
                subtitle: "";
            }
        }
    }

    // ================= More menu =================
    menu := PopupWindow {
        property <int> rows: root.remote-available ? 6 : 5;
        property <length> natural-row: 36px;
        property <length> seps: 2 * 11px;
        // Rows shrink to fit a short window.
        property <length> row-h: clamp((root.height - 12px - 12px - self.seps) / self.rows, 26px, self.natural-row);
        width: 280px;
        height: self.rows * self.row-h + self.seps + 12px;
        x: clamp(more.absolute-position.x + more.width - self.width, 6px, root.width - self.width - 6px);
        y: clamp(more.absolute-position.y - self.height - 6px, 6px, root.height - self.height - 6px);
        Rectangle {
            background: #1F1F1FF5;
            border-radius: 14px;
            border-width: 1px;
            border-color: T.hairline;
            drop-shadow-blur: 28px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: #00000080;
            VerticalLayout {
                padding: 6px;
                MenuRow {
                    height: menu.row-h;
                    text: root.s-topmost;
                    hint: root.shortcut + "T";
                    active: root.topmost;
                    commands: "M5,7 L14,7 L14,16 L5,16 Z M8,4 L17,4 L17,13";
                    bx: 5;
                    by: 4;
                    bw: 12;
                    bh: 12;
                    activated => { root.toggle-topmost(); }
                }
                MenuRow {
                    height: menu.row-h;
                    text: root.s-mini;
                    hint: root.shortcut + "M";
                    active: root.mini;
                    commands: "M4,6 L16,6 L16,14 L4,14 Z M7,11 L13,11";
                    bx: 4;
                    by: 6;
                    bw: 12;
                    bh: 8;
                    activated => { root.toggle-mini(); }
                }
                MenuRow {
                    height: menu.row-h;
                    text: root.s-show-queue;
                    hint: root.shortcut + "L";
                    active: root.queue-open;
                    commands: "M5,6 L15,6 M5,10 L15,10 M5,14 L15,14";
                    bx: 5;
                    by: 6;
                    bw: 10;
                    bh: 8;
                    activated => { root.toggle-queue(); }
                }
                if root.remote-available: MenuRow {
                    height: menu.row-h;
                    text: root.s-remote-mode;
                    active: root.remote-mode;
                    commands: "M7,6.5 C5,8.5 5,11.5 7,13.5 M13,6.5 C15,8.5 15,11.5 13,13.5 M4.5,4 C1.2,7.3 1.2,12.7 4.5,16 M15.5,4 C18.8,7.3 18.8,12.7 15.5,16 M10,9.7 L10,10.3";
                    bx: 1;
                    by: 3;
                    bw: 18;
                    bh: 14;
                    activated => { root.toggle-remote-mode(); }
                }
                Rectangle {
                    height: 11px;
                    Rectangle {
                        x: 8px;
                        width: parent.width - 16px;
                        height: 1px;
                        background: T.hairline-soft;
                    }
                }
                MenuRow {
                    height: menu.row-h;
                    text: root.s-add-files;
                    hint: root.shortcut + "O";
                    commands: "M10,4 L10,16 M4,10 L16,10";
                    bx: 4;
                    by: 4;
                    bw: 12;
                    bh: 12;
                    activated => { root.add-files(); }
                }
                Rectangle {
                    height: 11px;
                    Rectangle {
                        x: 8px;
                        width: parent.width - 16px;
                        height: 1px;
                        background: T.hairline-soft;
                    }
                }
                MenuRow {
                    height: menu.row-h;
                    text: root.s-quit;
                    hint: root.shortcut + "Q";
                    commands: "M4,4 L14,14 M14,4 L4,14";
                    bx: 4;
                    by: 4;
                    bw: 10;
                    bh: 10;
                    activated => { root.quit(); }
                }
            }
        }
    }

    // ================= Tooltip =================
    tooltip := Rectangle {
        property <bool> below: Tip.top - 30px < 4px;
        width: tip-text.preferred-width + 16px;
        height: 24px;
        x: clamp(Tip.x - self.width / 2, 4px, root.width - self.width - 4px);
        y: self.below ? Tip.bottom + 6px : Tip.top - self.height - 6px;
        border-radius: 8px;
        background: #1E1E1EF2;
        border-width: 1px;
        border-color: T.hairline;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: #00000060;
        opacity: Tip.shown ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: T.quick; easing: ease-out; }
        tip-text := Text {
            text: Tip.text;
            color: T.text;
            font-size: 11px;
        }
    }
}
